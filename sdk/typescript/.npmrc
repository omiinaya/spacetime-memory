# npm configuration for TypeScript SDK
# Registry for publishing to npmjs.org
registry=https://registry.npmjs.org/

# GitHub Packages registry (if needed for @github scoped packages)
# @github:registry=https://npm.pkg.github.com/

# Auth tokens should be provided via environment variables in CI
//registry.npmjs.org/:_authToken=${NODE_AUTH_TOKEN}
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# CI settings
audit=false
fund=false
prefer-offline=true
save-exact=true
engine-strict=true