{
  "name": "@omiinaya/spacetime-memory",
  "version": "0.2.0",
  "description": "TypeScript SDK for spacetime-memory",
  "main": "dist/client.js",
  "types": "dist/client.d.ts",
  "exports": {
    ".": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./compounder": {
      "types": "./dist/compounder.d.ts",
      "default": "./dist/compounder.js"
    },
    "./delta_sync": {
      "types": "./dist/delta_sync.d.ts",
      "default": "./dist/delta_sync.js"
    },
    "./ws_subscription": {
      "types": "./dist/ws_subscription.d.ts",
      "default": "./dist/ws_subscription.js"
    }
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build && npm test"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "25.9.5",
    "typescript": "^7.0",
    "vitest": "^4.1.9"
  }
}
