# ============================================================================
# Spacetime Memory — Environment Configuration
# ============================================================================
# Copy this file to .env and adjust for your environment:
#   cp .env.example .env
#
# Full reference: CONFIG.md
# ============================================================================

# --- SpacetimeDB Connection ---
SPACETIMEDB_HOST=localhost
SPACETIMEDB_PORT=3001
# The database identity hex string (printed by `spacetime publish`)
# Run: spacetime publish --project-path server/spacetimedb <your-db-name>
SPACETIMEDB_DB=spacetime-memory

# --- JWT Authentication ---
# Optional JWT token for persistent identity across HTTP requests.
# Generate with: python -c "from spacetime_memory.auth import generate_token; \
#   print(generate_token('data/id_ecdsa_pkcs8.pem'))"
# Or set via env var: SPACETIMEDB_TOKEN=eyJhbG...
# SPACETIMEDB_TOKEN=

# --- Embedder ---
EMBEDDER_URL=http://localhost:9090
# Embedder mode: auto (try local then OpenAI fallback), local, openai
EMBEDDER_TYPE=auto
# Path to ONNX model file (used in Docker, default: /app/model/all-MiniLM-L6-v2.onnx)
EMBEDDER_MODEL_PATH=server/embedder/model/all-MiniLM-L6-v2.onnx

# --- LLM Integration ---
# Required for AI features: memory synthesis, mental models, graph enrichment
# OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# --- MCP Server Auth ---
# When set, MCP HTTP/SSE tools require Authorization: Bearer <token>
# MCP_API_KEY=your-mcp-api-key

# --- Frontend (Vite) ---
VITE_SPACETIMEDB_WS=ws://localhost:3001
VITE_SPACETIMEDB_HOST=localhost:3001
VITE_SPACETIMEDB_DB=spacetime-memory
