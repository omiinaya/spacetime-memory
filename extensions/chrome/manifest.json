{
  "manifest_version": 3,
  "name": "Spacetime Memory Clipper",
  "version": "1.0.0",
  "description": "Clip web pages and selections to your Spacetime Memory workspace",
  "permissions": ["storage", "contextMenus", "activeTab", "notifications", "scripting"],
  "host_permissions": ["http://localhost:3001/*", "https://*/*", "http://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "clip-to-memory": {
      "suggestion": "Clip to Spacetime Memory",
      "description": "Clip current page to Spacetime Memory"
    }
  }
}
