# npm configuration for CI
# Registry for public packages
registry=https://registry.npmjs.org/

# GitHub Packages registry for @github scoped packages (if needed)
# @github:registry=https://npm.pkg.github.com/

# Always require auth for publishing
//registry.npmjs.org/:_authToken=${NODE_AUTH_TOKEN}
//npm.pkg.github.com/:_authToken=${GITHUB_TOKEN}

# Enable audit and fund messages in CI
audit=false
fund=false

# Prefer offline mode for faster CI
prefer-offline=true

# Save exact versions in package-lock.json
save-exact=true

# Don't create package-lock.json for devDependencies in CI
# package-lock=false

# Engine strict mode
engine-strict=true